{
  "$schema": "./scripts/oxcrap/configuration_schema.json",
  // What `npm run oxcrap` scores in this repository, and against what. The options are in
  // scripts/oxcrap/README.md; how to respond to a finding is in docs/engineering/crap.md.
  "files": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
  "limits": { "crap": 30, "complexity": 10 },
  // Every `npm test` writes this report, so run the tests first.
  "coverage": "coverage/coverage-final.json",
  "guide": "docs/engineering/crap.md"
}
