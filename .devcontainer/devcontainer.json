{
  "name": "SplitSmart sandbox",
  "image": "node:26-bookworm",
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": ["source=/run/sandbox/source,target=/run/sandbox/source,type=bind,readonly"],
  "forwardPorts": [3000],
  "postCreateCommand": "sh scripts/prepare-sandbox.sh"
}
