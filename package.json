{
  "name": "split",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --project unit --project browser && vitest run --project real --coverage.enabled=false --passWithNoTests",
    "test:tooling": "vitest run -c vitest.tooling.config.ts && vitest run -c vitest.tooling-real.config.ts && bddgen -c scripts/oxcrap/features/playwright.config.ts && playwright test -c scripts/oxcrap/features/playwright.config.ts",
    "test:mutation": "node scripts/mutation.ts",
    "test:mutation:changed": "node scripts/mutation.ts --changed",
    "test:e2e": "bddgen && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && gplint e2e/features && gplint -c scripts/oxcrap/features/.gplintrc scripts/oxcrap/features && node scripts/check-unused-steps.ts -c playwright.config.ts -c scripts/oxcrap/features/playwright.config.ts && rev-dep config run --list-all-issues --lint-config-rules orphan-file-globs,orphan-module-globs,overlapping-globs && rumdl check .",
    "format": "oxfmt && node scripts/format-features.ts e2e/features scripts/oxcrap/features",
    "format:check": "oxfmt --check && node scripts/format-features.ts --check e2e/features scripts/oxcrap/features",
    "oxcrap": "npm run oxcrap:app --silent && npm run oxcrap:tooling --silent",
    "oxcrap:app": "node scripts/oxcrap/oxcrap.ts",
    "oxcrap:tooling": "node scripts/oxcrap/oxcrap.ts -c scripts/oxcrap/.oxcraprc.json"
  },
  "dependencies": {
    "@liveblocks/client": "^3.24.5",
    "@liveblocks/yjs": "^3.24.5",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/functions": "^3.11.1",
    "lucide-react": "^1.62.0",
    "lz-string": "^1.5.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/gherkin-utils": "12.0.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-check": "4.10.2",
    "gplint": "2.6.1",
    "ignore": "7.0.14",
    "jsdom": "^30.1.3",
    "jsonc-parser": "3.3.1",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.65.0",
    "playwright-bdd": "9.2.1",
    "postcss": "^8.5.32",
    "rev-dep": "3.3.0",
    "rumdl": "0.3.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
