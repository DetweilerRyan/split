{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // jsx-a11y is oxlint's own port of eslint-plugin-jsx-a11y's rules, chosen over adding ESLint
  // and that plugin in https://github.com/DetweilerRyan/split/issues/67.
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y"],
  // The repository's own rules, in scripts/lint/functional.ts and scripts/lint/readonly.ts.
  "jsPlugins": ["./scripts/lint/functional.ts", "./scripts/lint/readonly.ts"],
  // The owner's decision (#120): type-aware linting, with tsrs as its backend. oxlint uses tsrs
  // because it's the only backend installed; don't also install oxlint-tsgolint.
  "options": { "typeAware": true },
  "rules": {
    // Least power (docs/engineering/code-design-principles.md, #120): a `switch` over a union
    // names every case, so adding one makes the linter name each `switch` that must handle it. A
    // `default` doesn't count, since a new case would fall into it unnoticed.
    "typescript/switch-exhaustiveness-check": "error",
    // Honest types (#132): an `any` claims every type, so parse it instead of reading it.
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    // Honest types (#132): a condition tests what it means, and one the types settle is dead code.
    // The owner chose the strictest options, so `''`, `0` and a nullable object aren't conditions.
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowString": false, "allowNumber": false, "allowNullableObject": false }
    ],
    // Honest types (#132): the owner chose `type` over `interface`; types-and-schemas.md says why.
    "typescript/consistent-type-definitions": ["error", "type"],
    // #132: promises and errors are handled as their types say, and nothing deprecated is used.
    "typescript/no-deprecated": "error",
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // #132: rules with no hits when turned on, from typescript-eslint's recommended, strict and
    // stylistic type-checked sets, which guard the code as it grows.
    "typescript/adjacent-overload-signatures": "error",
    "typescript/array-type": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-tslint-comment": "error",
    "typescript/ban-types": "error",
    "typescript/class-literal-property-style": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/dot-notation": "error",
    "typescript/method-signature-style": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-generated-empty-object-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-restricted-types": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unsafe-enum-assignment": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-var-requires": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/unified-signatures": "error",
    // The owner's rule (#81): "always use the function syntax for named functions. only use
    // lambdas when passing a function as data."
    "func-style": ["error", "declaration", { "allowArrowFunctions": false }],
    // The owner's decision (#76): "Tighter, tests exempt". Test files are exempt from
    // max-nested-callbacks in the override below.
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    // The owner's decision (#83): ban classes, except Error subclasses, and `this`.
    "functional/no-classes": "error",
    "functional/no-this": ["error", { "allowInClasses": true }],
    // Contained state (docs/engineering/code-design-principles.md, #116): a module-level `let` or
    // `var` is state that outlives every call. src/sync/, where long-lived state lives, is exempt
    // in an override below.
    "functional/no-module-let": "error",
    // Least power (#116): no `eval`, `new Function` or `Proxy`. The src/domain/ override repeats
    // Proxy, since an override's options replace these rather than adding to them.
    "no-eval": "error",
    "no-new-func": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "Proxy",
        "message": "Write the behaviour out as plain functions: a Proxy hides what a property access does (least power, docs/engineering/code-design-principles.md)."
      }
    ],
    // Deep modules (#116): a barrel file only passes another module's exports through. A
    // threshold of 0 reports every `export *`, not only one that loads over 100 modules.
    "oxc/no-barrel-file": ["error", { "threshold": 0 }],
    // The owner's decision (#117): honest types, in docs/engineering/code-design-principles.md.
    // `x as T` claims a type without checking it, so parse or narrow the value instead. `as const`
    // is still allowed, and tests are exempt in the override below.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    // The owner's decision (#69): the types we declare are readonly by default, checked level by
    // level. docs/engineering/types-and-schemas.md says what the rule asks for.
    "readonly/types": "error",
    // Contained state (docs/engineering/code-design-principles.md, #132): a function doesn't change
    // its caller's value, so each parameter's type is readonly all the way down, through imported
    // types too, which readonly/types doesn't see. Tests are included. `allow` lists the library
    // types the hits pass that the code can't make readonly; anything else is fixed or disabled.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true,
        "allow": [
          // React's children and form events, which React declares mutable.
          { "from": "package", "package": "react", "name": ["ReactNode", "SubmitEvent"] },
          // Yjs's shared types, which change in place by design: Y.Doc, and Y.Map, declared YMap.
          { "from": "package", "package": "yjs", "name": ["Doc", "YMap"] },
          // The DOM's and the language's own types, which TypeScript's lib declares mutable.
          { "from": "lib", "name": ["Error", "Request", "URL", "StorageEvent"] },
          // oxlint's plugin types, which the local lint rules take as oxlint gives them: any node
          // (declared Node$1), the node kinds a rule visits, and a rule for RuleTester.
          {
            "from": "package",
            "package": "oxlint",
            "name": ["Node$1", "ThisExpression", "VariableDeclaration", "TSTypeReference", "Rule"]
          },
          // zod's brand, a type-only marker on a branded id, and the issues a failed parse gives.
          { "from": "package", "package": "zod", "name": ["$brand", "$ZodIssue"] },
          // The end-to-end tests' browser page, and Vitest's browser locator.
          { "from": "package", "package": "playwright-core", "name": ["Page"] },
          { "from": "package", "package": "@vitest/browser", "name": ["Locator"] },
          // The schema errors Ajv gives oxCrap's config check.
          { "from": "package", "package": "ajv", "name": ["ErrorObject"] }
        ]
      }
    ],
    // The owner's decision (#119), for honest types (docs/engineering/code-design-principles.md):
    // no `!` claims a value the type says may be missing. Test files are exempt below.
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      // A test nests describe, it, fc.property and the callbacks inside by design (#76), and may use
      // `!` (#119), though not on an indexed read, as docs/engineering/types-and-schemas.md says.
      // A property test may spread a string of single-code-point characters into the characters
      // fast-check picks from (#120); no-misused-spread guards user text, which tests don't split.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-nested-callbacks": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-misused-spread": "off"
      }
    },
    {
      // Contained state (#116): src/sync/ keeps the room's long-lived state, so it may hold some
      // at module level.
      "files": ["src/sync/**"],
      "rules": { "functional/no-module-let": "off" }
    },
    {
      // #117: a test may cast to build a fake. The end-to-end tests and oxCrap's feature contract
      // are tests, screenplays included.
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**", "scripts/oxcrap/features/**"],
      "rules": { "typescript/consistent-type-assertions": "off" }
    },
    // The next two keep out the npm packages a layer in docs/engineering/code-layout.md may not
    // use, from #94. rev-dep checks which repository files a layer imports, not which packages;
    // dependency-direction.md lists both. Each regex matches a package and its subpaths, not a
    // relative path such as './y-axis', which a gitignore-style "y-*" group would.
    {
      // #94: no React, Next, icons, Yjs, sync providers, browser storage or server packages in
      // the domain. jsx-filename-extension with no extensions refuses JSX in every file: JSX
      // imports react/jsx-runtime with no import statement for no-restricted-imports to see.
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|react-dom|next|lucide-react|yjs|y-[^/]+|@liveblocks/[^/]+|idb|idb-keyval|localforage|dexie|@vercel/functions|mcp-handler|@modelcontextprotocol/[^/]+|dialog-closedby-polyfill)(/.*)?$",
                "message": "src/domain/ imports only src/domain/, src/utils/ and plain libraries such as zod: no UI, sync, browser storage or server packages (docs/engineering/code-layout.md)."
              }
            ]
          }
        ],
        // Core and shell (#116): no effects or hidden inputs in the domain. The browser's globals
        // and timers, and the clock and randomness, are the shell's, passed in as arguments.
        "no-restricted-globals": [
          "error",
          {
            "name": "Proxy",
            "message": "Write the behaviour out as plain functions: a Proxy hides what a property access does (least power, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "navigator",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "window",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "document",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "location",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "localStorage",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "sessionStorage",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "indexedDB",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "fetch",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "setTimeout",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "name": "setInterval",
            "message": "src/domain/ has no effects: take what this gives as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "src/domain/ has no hidden inputs: take the time or the random value as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          },
          {
            "object": "Math",
            "property": "random",
            "message": "src/domain/ has no hidden inputs: take the time or the random value as an argument, and let the shell pass it in (core and shell, docs/engineering/code-design-principles.md)."
          }
        ],
        "react/jsx-filename-extension": ["error", { "extensions": [] }]
      }
    },
    {
      // #94's "New src/services/": nothing UI or sync. That includes next/server with the rest of
      // next; code-layout.meta.md says why.
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|react-dom|next|lucide-react|yjs|y-[^/]+|@liveblocks/[^/]+)(/.*)?$",
                "message": "src/services/ imports no UI or sync packages (docs/engineering/code-layout.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
