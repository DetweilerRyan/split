{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // jsx-a11y is oxlint's own port of eslint-plugin-jsx-a11y's rules, chosen over adding ESLint
  // and that plugin in https://github.com/DetweilerRyan/split/issues/67.
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y"],
  // The repository's own rules, in scripts/lint/functional.ts.
  "jsPlugins": ["./scripts/lint/functional.ts"],
  "rules": {
    // The owner's rule (#81): "always use the function syntax for named functions. only use
    // lambdas when passing a function as data."
    "func-style": ["error", "declaration", { "allowArrowFunctions": false }],
    // The owner's decision (#76): "Tighter, tests exempt". Test files are exempt from
    // max-nested-callbacks in the override below.
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    // The owner's decision (#83): ban classes, except Error subclasses, and `this`.
    "functional/no-classes": "error",
    "functional/no-this": ["error", { "allowInClasses": true }]
  },
  // The npm packages a layer in docs/engineering/code-layout.md keeps out, from #94. rev-dep checks
  // which repository files a layer imports, not which packages; dependency-direction.md lists
  // both. Each regex matches a package and its subpaths, not a relative path such as './y-axis',
  // which a gitignore-style "y-*" group would.
  "overrides": [
    {
      // A test nests describe, it, fc.property and the callbacks inside by design (#76).
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "max-nested-callbacks": "off" }
    },
    {
      // #94: no React, Next, icons, Yjs, sync providers or browser storage in the domain.
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|react-dom|next|lucide-react|yjs|y-[^/]+|@liveblocks/[^/]+|idb|idb-keyval|localforage|dexie)(/.*)?$",
                "message": "src/domain/ imports only src/domain/, src/utils/ and plain libraries such as zod: no UI, sync or browser storage (docs/engineering/code-layout.md)."
              }
            ]
          }
        ]
      }
    },
    {
      // #94: services "may import domain/ and utils/, but nothing UI or sync".
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|react-dom|next|lucide-react|yjs|y-[^/]+|@liveblocks/[^/]+)(/.*)?$",
                "message": "src/services/ imports no UI or sync packages (docs/engineering/code-layout.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
